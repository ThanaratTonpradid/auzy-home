    "test": "pnpm --filter @smart-home/api test"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@node-rs/argon2"]
  }
}
