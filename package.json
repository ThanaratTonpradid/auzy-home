{
  "name": "smart-home",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:seed": "pnpm --filter @smart-home/api db:seed",
